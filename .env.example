# Copy to .env and fill in. Never commit .env.
# Every setting and its default is in src/policypal/config.py; only the three
# with no default are required.

# --- Required ---
DATABASE_URL=postgresql+psycopg://policypal:password@localhost:5432/policypal
OPENAI_API_KEY=
# A long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET_KEY=

# --- Optional ---
# Live plan prices come from the CMS Marketplace API. Without a key, plan
# search still works from the stored catalog; the prices are the stored
# age-27 ones rather than the user's age.
CMS_MARKETPLACE_API_KEY=

# "production" switches logs to JSON on stdout as well as to a file.
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_DIR=logs/backend

# Where the browser app is served from. CORS allows this origin and no other.
FRONTEND_ORIGIN=http://localhost:5173
